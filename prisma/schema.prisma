generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Profile: Optional user metadata table linked to Supabase Auth users.
/// Purpose: Maintain stable user records and extensible metadata.
model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id")
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("profiles")
}