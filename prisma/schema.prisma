generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Profile: Optional user metadata table linked to Supabase Auth users.
/// Purpose: Maintain stable user records and extensible metadata.
model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id")
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("profiles")
}

/// Project: Top-level entity for a downsizing/moving project.
/// Purpose: Organize all items, rooms, and containers under a single owner.
/// Invariants: Every project belongs to exactly one Supabase auth user (ownerUserId).
model Project {
  id            String          @id @default(uuid()) @db.Uuid
  ownerUserId   String          @map("owner_user_id")
  name          String
  createdAt     DateTime        @default(now()) @map("created_at")
  rooms         Room[]
  containers    Container[]
  items         Item[]
  itemMoveEvents ItemMoveEvent[]

  @@map("projects")
}

/// Room: Physical location within a project (kitchen, bedroom, etc).
/// Purpose: Every item and container must belong to a room.
/// Invariants: slug is unique per project, generated server-side from name.
model Room {
  id         String      @id @default(uuid()) @db.Uuid
  projectId  String      @map("project_id") @db.Uuid
  name       String
  slug       String
  createdAt  DateTime    @default(now()) @map("created_at")
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  containers Container[]
  items      Item[]

  @@unique([projectId, slug])
  @@map("rooms")
}

/// Container: Physical box/tote that holds items.
/// Purpose: Track items by container with human-readable codes.
/// Invariants:
/// - code is unique per project
/// - seq is unique per (project, room)
/// - code format: {roomSlug}-BOX-{seq} (e.g., kitchen-BOX-0001)
model Container {
  id              String          @id @default(uuid()) @db.Uuid
  projectId       String          @map("project_id") @db.Uuid
  roomId          String          @map("room_id") @db.Uuid
  seq             Int
  code            String
  createdAt       DateTime        @default(now()) @map("created_at")
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  room            Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  items           Item[]
  movesFrom       ItemMoveEvent[] @relation("MoveFrom")
  movesTo         ItemMoveEvent[] @relation("MoveTo")

  @@unique([projectId, code])
  @@unique([projectId, roomId, seq])
  @@map("containers")
}

/// Item: Individual item or group of items captured during inventory.
/// Purpose: Core entity for downsizing inventory management.
/// Invariants:
/// - Every item must belong to a room (roomId required)
/// - kind: "single" or "group"
/// - containerId is optional (items may not be packed yet)
/// - handlingType: "containerable" (fits in box) or "bulky" (doesn't fit)
model Item {
  id            String          @id @default(uuid()) @db.Uuid
  projectId     String          @map("project_id") @db.Uuid
  roomId        String          @map("room_id") @db.Uuid
  containerId   String?         @map("container_id") @db.Uuid
  title         String?
  kind          String          @default("single") // "single" | "group"
  count         Int             @default(1)
  notes         String?         @db.Text
  handlingType  String          @default("containerable") @map("handling_type") // "containerable" | "bulky"
  createdAt     DateTime        @default(now()) @map("created_at")
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  room          Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  container     Container?      @relation(fields: [containerId], references: [id], onDelete: SetNull)
  images        ItemImage[]
  moveEvents    ItemMoveEvent[]

  @@map("items")
}

/// ItemImage: Photo of an item stored in Supabase Storage.
/// Purpose: Store both thumbnail and display versions of item photos.
/// Invariants:
/// - kind: "thumb" or "display"
/// - path points to Supabase Storage location
model ItemImage {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  path      String
  kind      String // "thumb" | "display"
  createdAt DateTime @default(now()) @map("created_at")
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("item_images")
}

/// ItemMoveEvent: Physical movement event log for Shuffle Mode.
/// Purpose: Track when items move between containers for chain-of-custody.
/// Invariants:
/// - One event per item per move.
/// - fromContainerId nullable (item may originate without container).
/// - toContainerId nullable (item may be removed from container).
/// - After event is written, Item.containerId and Item.roomId are updated.
model ItemMoveEvent {
  id              String     @id @default(uuid()) @db.Uuid
  projectId       String     @map("project_id") @db.Uuid
  itemId          String     @map("item_id") @db.Uuid
  fromContainerId String?    @map("from_container_id") @db.Uuid
  toContainerId   String?    @map("to_container_id") @db.Uuid
  movedAt         DateTime   @default(now()) @map("moved_at")
  movedByUserId   String     @map("moved_by_user_id")
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item            Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromContainer   Container? @relation("MoveFrom", fields: [fromContainerId], references: [id], onDelete: SetNull)
  toContainer     Container? @relation("MoveTo", fields: [toContainerId], references: [id], onDelete: SetNull)

  @@map("item_move_events")
}